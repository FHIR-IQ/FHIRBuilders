# ===========================================
# FHIRBuilders Environment Configuration
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fhirbuilders?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Medplum FHIR Backend
MEDPLUM_BASE_URL="https://api.medplum.com/"
MEDPLUM_CLIENT_ID=""
MEDPLUM_CLIENT_SECRET=""

# Public Medplum config (exposed to browser)
NEXT_PUBLIC_MEDPLUM_BASE_URL="https://api.medplum.com/"
NEXT_PUBLIC_MEDPLUM_CLIENT_ID=""

# Anthropic AI (Claude API for OpenClaw code generation and medication analysis)
ANTHROPIC_API_KEY=""

# Hugging Face Integration
HUGGINGFACE_API_KEY=""

# FHIR Zulip Integration
ZULIP_SITE_URL="https://chat.fhir.org"
ZULIP_API_KEY=""
ZULIP_EMAIL=""

# Stripe (cohort contributions + Cohort 01 paid enrollment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cohort 01 community (Buzz workspace invite link — shown on the /cohort-01/enrolled page)
NEXT_PUBLIC_BUZZ_INVITE_URL=""

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
